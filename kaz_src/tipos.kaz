// ============================================================================
// TermiKAZ v2.0 Soberano (100% Kaz Puro)
// tipos.kaz: Estruturas de Dados do Emulador de Terminal
// ============================================================================

struct TermCor {
    int r;
    int g;
    int b;
}

struct TermCelula {
    int codepoint;       // Caractere ASCII / Unicode
    int fg_cor;          // Cor do texto (RGB 0x00RRGGBB)
    int bg_cor;          // Cor de fundo (RGB 0x00RRGGBB)
    bool negrito;
    bool sublinhado;
    bool reverso;
}

struct TermCursor {
    int x;
    int y;
    bool visivel;
    int estilo;          // 0 = Bloco, 1 = Linha, 2 = Underline
}

struct TermBuffer {
    int colunas;
    int linhas;
    int scroll_offset;
    int max_scrollback;
    int cursor_x;
    int cursor_y;
}

struct TermAba {
    int id;
    string titulo;
    string cwd;
    bool ativa;
    int buffer_id;
}

struct TermConfig {
    string nome_fonte;
    int tamanho_fonte;
    int padding_x;
    int padding_y;
    bool copilot_ativo;
    string copilot_modelo_path;
    int opacidade_fundo; // 0 a 100%
}
