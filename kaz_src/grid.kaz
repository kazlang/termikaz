import "tipos.kaz";

function criar_celula_vazia(int bg_cor): TermCelula {
    return TermCelula {
        codepoint: 32,
        fg_cor: 0x00CDD6F4,
        bg_cor: bg_cor,
        negrito: false,
        sublinhado: false,
        reverso: false
    };
}
