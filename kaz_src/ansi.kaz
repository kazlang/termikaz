// ansi.kaz: Parser de Sequências de Escape ANSI, VT100 e SGR 24-bit TrueColor
// ============================================================================

import "tipos.kaz";

function rgb_para_hex(int r, int g, int b): int {
    return (r << 16) | (g << 8) | b;
}

function obter_cor_ansi_padrao(int indice): int {
    if (indice == 0) { return 0x001E1E2E; }
    if (indice == 1) { return 0x00F38BA8; }
    if (indice == 2) { return 0x00A6E3A1; }
    if (indice == 3) { return 0x00F9E2AF; }
    if (indice == 4) { return 0x0089B4FA; }
    if (indice == 5) { return 0x00CBA6F7; }
    if (indice == 6) { return 0x0089DCEB; }
    if (indice == 7) { return 0x00BAC2DE; }

    if (indice == 8) { return 0x00585B70; }
    if (indice == 9) { return 0x00EBA0AC; }
    if (indice == 10) { return 0x0094E2D5; }
    if (indice == 11) { return 0x00F9E2AF; }
    if (indice == 12) { return 0x0074C7EC; }
    if (indice == 13) { return 0x00F5C2E7; }
    if (indice == 14) { return 0x00B4BEFE; }
    if (indice == 15) { return 0x00A6ADC8; }

    return 0x00CDD6F4;
}

struct AnsiParserEstado {
    bool em_escape;
    bool em_csi;
    string param_buffer;
    int fg_atual;
    int bg_atual;
    bool negrito_atual;
}

function criar_ansi_parser(): AnsiParserEstado {
    return AnsiParserEstado {
        em_escape: false,
        em_csi: false,
        param_buffer: "",
        fg_atual: 0x00CDD6F4,
        bg_atual: 0x0011111B,
        negrito_atual: false
    };
}

function ansi_processar_char(AnsiParserEstado estado, int c): int {
    if (c == 27) {
        estado.em_escape = true;
        estado.em_csi = false;
        estado.param_buffer = "";
        return 1;
    }

    if (estado.em_escape) {
        if (c == 91) {
            estado.em_csi = true;
            estado.em_escape = false;
            return 1;
        } else {
            estado.em_escape = false;
            return 1;
        }
    }

    if (estado.em_csi) {
        if (c >= 64 && c <= 126) {
            estado.em_csi = false;
            if (c == 109) {
                ansi_aplicar_sgr(estado, estado.param_buffer);
            }
            return 1;
        }
        return 1;
    }

    return 0;
}

function ansi_aplicar_sgr(AnsiParserEstado estado, string params) {
    if (params == "" || params == "0") {
        estado.fg_atual = 0x00CDD6F4;
        estado.bg_atual = 0x0011111B;
        estado.negrito_atual = false;
        return;
    }

    if (params == "1") {
        estado.negrito_atual = true;
        return;
    }
}
