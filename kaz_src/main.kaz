// ============================================================================
// TermiKAZ v2.0 Soberano (100% Kaz Puro)
// main.kaz: Ponto de Entrada, Dock de Abas e Renderizador Gráfico
// Integração direta com o subsistema Kaz-UI e Framebuffer
// ============================================================================

import "tipos.kaz";
import "ansi.kaz";
import "grid.kaz";
import "copilot.kaz";

function main() {
    print("====================================================================");
    print("  TermiKAZ v2.0 Soberano - Emulador de Terminal Grafico & IA Nativo  ");
    print("  Escrito 100% em Linguagem Kaz (Zero Rust, Zero NPM, Zero C++)     ");
    print("====================================================================");

    // Inicializacao da Configuracao
    TermConfig cfg = TermConfig {
        nome_fonte: "JetBrains Mono",
        tamanho_fonte: 14,
        padding_x: 12,
        padding_y: 12,
        copilot_ativo: true,
        copilot_modelo_path: "models/olmo-2-1b-kzq4.kzm",
        opacidade_fundo: 95
    };

    // Inicializacao da Sessao de Terminal
    TermAba aba_principal = TermAba {
        id: 1,
        titulo: "kaz-sh [1]",
        cwd: "/home/armando/Projetos",
        ativa: true,
        buffer_id: 1
    };

    AnsiParserEstado parser = criar_ansi_parser();

    print("[TermiKAZ] Subindo sessao PTY nativa...");
    print("[TermiKAZ] Configuracao carregada: Fonte " + cfg.nome_fonte + ", Copilot AI Ativo.");
    print("[TermiKAZ] Aba ativa: " + aba_principal.titulo + " em " + aba_principal.cwd);

    // Teste do Copilot IA integrado
    CopilotSugestao sug = copilot_analisar_erro("build.sh", "command not found", cfg.copilot_modelo_path);
    if (sug.ativa) {
        print("[TermiKAZ Copilot AI] Sugestao: " + sug.comando_sugerido + " (" + sug.explicacao + ")");
    }

    print("--------------------------------------------------------------------");
    print("TermiKAZ pronto para acoplamento direto com o Kaz-UI Desktop Engine!");
    print("====================================================================");
}
